{
  "manifest_version": 3,
  "name": "Claude Trees",
  "version": "0.1.0",
  "description": "See the hidden branch tree of a claude.ai conversation, and jump between branches.",
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Show conversation tree"
  },
  "commands": {
    "toggle-tree": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Toggle the conversation tree overlay"
    }
  }
}
